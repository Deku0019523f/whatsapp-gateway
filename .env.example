PORT=3000

# Clé admin : nécessaire pour créer/gérer les utilisateurs (à garder secrète côté backend My Atelier)
ADMIN_KEY=change_this_admin_key

# URL publique du VPS (utilisée dans la doc générée)
PUBLIC_URL=http://VOTRE_IP_VPS:3000

# --- Sécurité ---
# Origines navigateur autorisées (CORS + Socket.io), séparées par des virgules.
# Vide = toutes les origines (à éviter en production).
# ALLOWED_ORIGINS=https://premium225.shop

# Derrière Nginx sur le même serveur : laisser "loopback". Autre reverse proxy : voir la doc Express "trust proxy".
TRUST_PROXY=loopback

# Limites (valeurs par défaut) : requêtes/min/IP, échecs d'authentification/15 min/IP, envois/min/utilisateur
# RATE_LIMIT_PER_MIN=600
# AUTH_FAILURES_PER_15MIN=20
# SEND_LIMIT_PER_MIN=60

# --- Webhooks ---
# Nombre max de tentatives par événement (backoff 5 s, 30 s, 2 min, 10 min, 1 h, 6 h...)
# WEBHOOK_MAX_ATTEMPTS=8
# Mettre false pour ne plus envoyer l'ancien header x-webhook-key (la signature x-webhook-signature suffit)
# WEBHOOK_LEGACY_KEY_HEADER=true

# --- Transcription automatique des messages vocaux (Groq Whisper) ---
# Active dès que la clé est renseignée : https://console.groq.com/keys
GROQ_API_KEY=
# Langue pour guider la reconnaissance (fr, en...) ; vide = détection automatique
TRANSCRIPTION_LANGUAGE=fr
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# TRANSCRIPTION_MAX_SECONDS=300
# TRANSCRIPTION_ENABLED=true

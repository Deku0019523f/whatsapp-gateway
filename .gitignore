# Dépendances
node_modules/

# Variables d'environnement (ADMIN_KEY, etc.)
.env

# Sessions WhatsApp (credentials Baileys) — sensible, jamais à commiter
auth_sessions/*
!auth_sessions/vide

# Base SQLite (utilisateurs, clés API, messages, file de webhooks) générée au runtime
data/gateway.db
data/gateway.db-wal
data/gateway.db-shm

# Anciens fichiers JSON, renommés après leur import automatique dans SQLite
data/users.json
data/messages/
data/users.json.migrated
data/messages.migrated/

# Fichiers temporaires uploadés avant envoi WhatsApp
uploads/*
!uploads/vide

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db
